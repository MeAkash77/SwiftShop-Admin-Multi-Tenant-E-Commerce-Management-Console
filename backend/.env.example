#MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/ecommerce
MONGODB_URL=mongodb://localhost:27017/ecommerce
PORT=3000
JWT_TOKEN_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
# Access JWT lifetime (examples: 15m, 1h, 2h)
JWT_ACCESS_EXPIRES=1h
# Refresh JWT / stay-logged-in lifetime (examples: 7d, 30d)
JWT_REFRESH_EXPIRES=30d
# Local frontend (comma-separated if Vite uses 5174+)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Production (Vercel frontend)
# CLIENT_URL=https://multicommerce-web.vercel.app
EMAIL_USER=example@gmail.com
EMAIL_PASS=your_gmail_app_password
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
ADMIN_SETUP_SECRET=change_me_to_a_long_random_secret
# Optional Redis (Docker: redis://redis:6379 | Upstash: rediss://...)
# Leave empty to skip cache (app still works)
REDIS_URL=
# Mongo connection pool (Docker ~20, Vercel auto ~5)
MONGO_MAX_POOL=20

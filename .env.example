# Copy to .env for docker compose (never commit secrets)
MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/ecommerce
API_PORT=3000
MONGO_MAX_POOL=20
JWT_TOKEN_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
# Add every portal host here (comma-separated). Include portal subdomains if used.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://multicommerce-web.vercel.app

{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:customer": "cross-env VITE_DEV_PORTAL=customer vite --port 5173 --strictPort --open /customer",
    "dev:vendor": "cross-env VITE_DEV_PORTAL=vendor vite --port 5174 --strictPort --open /vendor/login",
    "dev:admin": "cross-env VITE_DEV_PORTAL=admin vite --port 5175 --strictPort --open /admin/login",
    "dev:all": "concurrently -k -n customer,vendor,admin -c cyan,green,magenta \"npm run dev:customer\" \"npm run dev:vendor\" \"npm run dev:admin\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/extension-color": "^3.27.4",
    "@tiptap/extension-highlight": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/extension-placeholder": "^3.27.4",
    "@tiptap/extension-text-align": "^3.27.4",
    "@tiptap/extension-text-style": "^3.27.4",
    "@tiptap/extension-underline": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}

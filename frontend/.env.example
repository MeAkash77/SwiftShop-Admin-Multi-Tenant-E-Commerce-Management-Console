# Local API (used in production builds). Dev uses Vite proxy → localhost:3000
VITE_API_URL=http://localhost:3000/api

# Optional: override Vite proxy target (default http://localhost:3000)
# VITE_API_PROXY_TARGET=http://localhost:3000

# Multi-port dev (set automatically by npm run dev:customer | dev:vendor | dev:admin)
# VITE_DEV_PORTAL=customer

# --- Production single-portal builds ---
# Lock this deployment to ONE portal so "/" opens it directly.
# One of: customer | vendor | admin. Leave empty for the full app.
# (Alternatively, deploy once and use subdomains like vendor.yoursite.com —
#  the portal is auto-detected from the subdomain.)
# VITE_PORTAL=vendor

# Optional: absolute origins when portals live on different hosts (opens new tabs)
# VITE_CUSTOMER_ORIGIN=https://shop.yoursite.com
# VITE_VENDOR_ORIGIN=https://vendor.yoursite.com
# VITE_ADMIN_ORIGIN=https://admin.yoursite.com

# Production (Vercel backend)
# VITE_API_URL=https://multicommerce-api.vercel.app/api
